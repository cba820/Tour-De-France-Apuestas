[Unit]
Description=Apuestas La Vuelta a Espana 2026 (Flask + gunicorn)
After=network.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/TDF_apuestas

# --- Configuración: CAMBIA estos valores ---
Environment=SECRET_KEY=pon-aqui-una-clave-larga-y-secreta
Environment=ADMIN_USERNAME=admin
Environment=ADMIN_PASSWORD=cambia-esta-clave-admin
Environment=ADMIN_EMAIL=admin@tdf.local

# --- Recordatorios de votación por email ---
# DESACTIVADOS a peticion del organizador: con REMINDERS_ENABLED=0 el scheduler
# no programa el envio diario y el panel de admin oculta los botones de envio.
# Para reactivarlos: REMINDERS_ENABLED=1 + una cuenta Gmail con verificacion en
# 2 pasos y una "App Password" de 16 caracteres (NO la contrasena normal).
Environment=REMINDERS_ENABLED=0
Environment=MAIL_USERNAME=sebastianorellana820@gmail.com
Environment=MAIL_PASSWORD=pon-aqui-la-app-password-de-gmail
Environment=MAIL_FROM=sebastianorellana820@gmail.com
Environment=SITE_URL=http://ec2-18-221-241-6.us-east-2.compute.amazonaws.com
# Hora (Chile) del recordatorio diario. Por defecto 20:00.
Environment=REMINDER_HOUR=20
Environment=REMINDER_MINUTE=0

# Permite escuchar en el puerto 80 sin ser root.
AmbientCapabilities=CAP_NET_BIND_SERVICE

# 1 solo worker (obligatorio por el scheduler interno) + hilos para atender
# a varios amigos a la vez.
ExecStart=/home/ec2-user/TDF_apuestas/.venv/bin/gunicorn \
    --workers 1 --threads 4 --timeout 120 \
    --bind 0.0.0.0:80 wsgi:app

Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
